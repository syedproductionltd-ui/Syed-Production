{
  "trailingSlash": false,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "redirects": [
    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/portfolio.html", "destination": "/portfolio", "statusCode": 301 },
    { "source": "/gallery.html", "destination": "/gallery", "statusCode": 301 },
    { "source": "/booking.html", "destination": "/booking", "statusCode": 301 },
    { "source": "/contact.html", "destination": "/contact", "statusCode": 301 },
    { "source": "/reviews.html", "destination": "/reviews", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(images|videos)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(portfolio|gallery|booking|contact|reviews|admin)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
